<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Capstone Suite">

    <!-- Parallel CRUD Tests -->
    <test name="UI/API CRUD Tests"
          parallel="classes"
          thread-count="2">

        <classes>

            <class name="tests.ui.LoginTest"/>
            <class name="tests.ui.CreateNoteTest"/>
            <class name="tests.ui.DeleteNoteTest"/>

            <class name="tests.api.GetNotesApiTest"/>
            <class name="tests.api.CreateNoteApiTest"/>
            <class name="tests.api.DeleteNoteApiTest"/>

        </classes>

    </test>

    <!-- Sequential Hybrid E2E -->
    <test name="Hybrid E2E Tests">

        <classes>

            <class name="tests.e2e.HybridE2ETest"/>

        </classes>

    </test>

</suite>